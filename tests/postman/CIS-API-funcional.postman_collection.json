{
  "info": {
    "name": "CIS API - Pruebas funcionales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verificada con Postman CLI contra CIS con MySQL y MongoDB aislados, usando Users API de fixture. Para servicios reales configurar login/password y ejecutar autenticación. La carpeta CRUD crea sus propios recursos y al final los elimina lógicamente. Los datos migrados se usan solo para lectura. Evidencia y límites en docs/phase2/status.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5039"
    },
    {
      "key": "usersBaseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "login",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "seedTopicId",
      "value": ""
    },
    {
      "key": "seedIdeaId",
      "value": ""
    },
    {
      "key": "newTopicId",
      "value": ""
    },
    {
      "key": "newIdeaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticación",
      "item": [
        {
          "name": "00 - Obtener JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usersBaseUrl}}/auth/login",
            "description": "Usar una cuenta cuya contraseña conozcas. El SQL genera contraseñas aleatorias para los perfuser; el código local compara la contraseña recibida con el valor almacenado.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"JWT presente\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  "    if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "    if (data.id) pm.collectionVariables.set(\"userId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Lectura de datos migrados",
      "item": [
        {
          "name": "01 - Listar temas existentes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics?page=1&pageSize=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Buscar temas del seed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics?search=PERF_TEST_Topic_&page=1&pageSize=10&sortBy=Title&sortDirection=Asc",
            "description": "El seed genera 495 títulos PERF_TEST_Topic_. Los conteos dependen de que se haya aplicado y migrado sin cambios."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Temas más activos y seleccionar tema con ideas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/statistics/topics/most-active?page=1&pageSize=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "    const topic = pm.response.json().items.find(t => t.ideaCount > 0);",
                  "    pm.test(\"Hay un tema con ideas para las lecturas siguientes\", () => pm.expect(topic).to.exist);",
                  "    if (topic) pm.collectionVariables.set(\"seedTopicId\", String(topic.topicId));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Obtener tema existente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{seedTopicId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"ID solicitado\", () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"seedTopicId\")));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Ideas del tema existente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{seedTopicId}}/ideas?page=1&pageSize=10&sortBy=CreatedAt&sortDirection=Desc",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}",
                  "if (pm.response.code === 200 && pm.response.json().items.length) {",
                  "    pm.collectionVariables.set(\"seedIdeaId\", String(pm.response.json().items[0].id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Ideas más votadas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/statistics/ideas/most-voted?page=1&pageSize=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "    const counts = pm.response.json().items.map(i => i.voteCount);",
                  "    pm.test(\"Votos en orden descendente\", () => {",
                  "        for (let n = 1; n < counts.length; n++) pm.expect(counts[n]).to.be.at.most(counts[n - 1]);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Filtrar temas activos por usuario autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics?status=Active&userId={{userId}}&page=1&pageSize=10",
            "description": "Una página vacía es válida si la cuenta autenticada no tiene temas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Respuesta paginada\", () => {",
                  "        pm.expect(page.items).to.be.an(\"array\");",
                  "        pm.expect(page.totalItems).to.be.a(\"number\");",
                  "        pm.expect(page.items.length).to.be.at.most(10);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Flujo CRUD con recursos propios",
      "item": [
        {
          "name": "01 - Crear tema propio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"POSTMAN - Mejoras del campus\",\n  \"description\": \"Tema creado para verificar el flujo funcional.\",\n  \"tags\": [\n    \"PostmanDemo\",\n    \"MongoDB\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"ID generado\", () => pm.expect(data.id).to.be.above(0));",
                  "    pm.collectionVariables.set(\"newTopicId\", String(data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consultar tema creado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Buscar por etiqueta creada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics?tag=postmandemo&page=1&pageSize=100",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"El tema creado aparece al filtrar por etiqueta\", () => {",
                  "        pm.expect(pm.response.json().items.some(t => String(t.id) === pm.collectionVariables.get(\"newTopicId\"))).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Actualizar tema propio",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"POSTMAN - Tema actualizado\",\n  \"description\": \"Descripción actualizada desde Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.test(\"Título actualizado\", () => pm.expect(pm.response.json().title).to.eql(\"POSTMAN - Tema actualizado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Crear idea propia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"POSTMAN - Ampliar horarios de biblioteca\",\n  \"description\": \"Habilitar atención en horarios adicionales.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"ID generado\", () => pm.expect(data.id).to.be.above(0));",
                  "    pm.collectionVariables.set(\"newIdeaId\", String(data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Consultar ideas del tema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas?page=1&pageSize=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.test(\"Idea creada presente\", () => pm.expect(pm.response.json().items.some(i => String(i.id) === pm.collectionVariables.get(\"newIdeaId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Actualizar idea propia",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ideas/{{newIdeaId}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"POSTMAN - Idea actualizada\",\n  \"description\": \"Propuesta actualizada desde Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.test(\"Idea actualizada\", () => pm.expect(pm.response.json().title).to.eql(\"POSTMAN - Idea actualizada\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Votar idea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas/{{newIdeaId}}/votes",
            "description": "Sin cuerpo. El usuario se obtiene del JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Repetir voto - conflicto esperado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas/{{newIdeaId}}/votes",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Quitar voto propio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas/{{newIdeaId}}/votes",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Quitar voto nuevamente - no encontrado",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas/{{newIdeaId}}/votes",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Eliminar idea propia",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas/{{newIdeaId}}",
            "description": "Eliminación lógica."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Comprobar que la idea eliminada no se lista",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}/ideas?page=1&pageSize=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.test(\"Idea eliminada ausente\", () => {",
                  "    const page = pm.response.json();",
                  "    pm.expect(page.items.some(i => String(i.id) === pm.collectionVariables.get(\"newIdeaId\"))).to.eql(false);",
                  "    pm.expect(page.totalItems).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "14 - Eliminar tema propio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}",
            "description": "Eliminación lógica. Las etiquetas compartidas permanecen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "15 - Comprobar tema eliminado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/topics/{{newTopicId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
